PORT=5000
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES=7d
# Leave MONGO_URI empty to boot an embedded MongoDB with sample data.
# Data resets when the API process stops. For a persistent database use:
# MONGO_URI=mongodb://127.0.0.1:27017/eventsphere
MONGO_URI=
CLIENT_ORIGIN=http://localhost:5173
SEED=true
